 ___  ___  ___  ___  ___  ___                                                  GRN  GRN  GRN  GRN  ORG  ORG
           ___  ___  ___                                                            GRN  ORG  RED
                                               ___  ___  ___  ___  ORG  ORG
            >;
        };

        /* Momentary layer: stays lit while held */
        layer_NumRow {
