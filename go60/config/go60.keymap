            POS_LH_C5R1 POS_LH_C5R2 POS_LH_C5R3 POS_LH_C5R4
            POS_LH_C6R1 POS_LH_C6R2 POS_LH_C6R3 POS_LH_C6R4
        >;
#endif

        /* Base layer: Caps Lock status light on td_caps */
        layer_Base {
            layer-id = <LAYER_Base>;
            bindings = <
 ___  ___  ___  ___  ___  ___                                                  ___  ___  ___  ___  ___  ___
 CPL  ___  ___  ___  ___  ___                                                  ___  ___  ___  ___  ___  ___
 ___  ___  ___  ___  ___  ___                                                  ___  ___  ___  ___  ___  ___
 ___  ___  ___  ___  ___  ___                                                  ___  ___  ___  ___  ___  ___
           ___  ___  ___                                                            ___  ___  ___
                                               ___  ___  ___  ___  ___  ___
            >;
        };

        /* Permanent layer: lights up for 3s when toggled on, then fades out */
        layer_PC {
            layer-id = <LAYER_PC>;
            fade-delay = <3>;
            bindings = <
 ___  ___  ___  ___  ___  ___                                                  ___  ___  ___  ___  ___  ___
 ___  ___  ___  ___  ___  ___                                                  ___  ___  ___  ___  ___  ___
 ___  ___  ___  ___  ___  ___                                                  ___  ___  ___  ___  ___  ___
 ___  ___  ___  ___  ___  ___                                                  ___  ___  ___  ___  ___  ___
           BLU  ___  ___                                                            ___  ___  ___
                                               ___  ___  ___  ___  ___  ___
            >;
        };

        /* Permanent layer: lights up for 3s when toggled on, then fades out */
        layer_Gaming {
            layer-id = <LAYER_Gaming>;
            fade-delay = <3>;
            bindings = <
 ___  ___  ___  ___  ___  ___                                                  ___  ___  ___  ___  ___  ___
 ORG  ___  ___  ___  ___  ___                                                  ___  ___  ___  ___  ___  ___
 ___  RED  RED  RED  ORG  ___                                                  ___  ORG  ORG  ORG  ORG  ___
 ORG  ___  ___  ___  ___  ___                                                  ___  ___  ___  ___  ___  ___
           ORG  ORG  GRN                                                            ___  ___  ___
                                               ___  ORG  ORG  ___  ___  ___
            >;
        };

        /* Momentary layer: stays lit while held */
        layer_SymbolNav {
            layer-id = <LAYER_SymbolNav>;
            bindings = <
 ___  CYN  CYN  CYN  CYN  CYN                                                  CYN  CYN  CYN  CYN  CYN  CYN
 ___  ORG  GLD  GLD  ORG  ___                                                  ORG  ORG  ORG  ORG  ORG  CYN
