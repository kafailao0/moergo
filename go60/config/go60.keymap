 MAG  ORG  GLD  GLD  ORG  ___                                                  ORG  ORG  ORG  ORG  ORG  MAG
           ___  ___  ___                                                            ___  ___  ___
                                               ___  RED  ___  ___  ___  ___
            >;
        };

        /* Hybrid layer: stays lit while active (both held and double-tap toggled) */
        layer_Keypad {
            layer-id = <LAYER_Keypad>;
            bindings = <
 RED  ___  ___  ___  ___  ___                                                  ___  ___  ___  ___  ___  ___
 ___  ___  ___  ___  ___  ___                                                  ORG  GRN  GRN  GRN  ORG  ORG
