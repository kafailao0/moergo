/ {
    behaviors {
        // home_row_mod_left

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            quick-tap-ms = <250>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <RIGHT_HAND_KEYS POS_RH_T1 POS_RH_T2 POS_RH_T3>;
            hold-trigger-on-release;
        };

        // home_row_mod_right

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            quick-tap-ms = <250>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <LEFT_HAND_KEYS POS_LH_T1 POS_LH_T2 POS_LH_T3>;
            hold-trigger-on-release;
        };

        hold_tap_layer: hold_tap_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;

            flavor = "tap-preferred";
            quick-tap-ms = <175>;
        };

        /* @viewer: Caps | @badge: TD | @tooltip: Tap Dance: 1x Caps Word • 2x Caps Lock */
        td_caps: td_caps {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_CAPS";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&caps_word>, <&kp CAPS>;
        };

        /* @viewer: Copy | Paste | @badge: TD | @tooltip: Tap Dance: 1x ⌘C (Copy) • 2x ⌘V (Paste) */
        td_copy_paste: td_copy_paste {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_COPY_PASTE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LG(C)>, <&kp LG(V)>;
        };

        /* @viewer: Copy | Paste | @badge: TD | @tooltip: Tap Dance: 1x Ctrl+C (Copy) • 2x Ctrl+V (Paste) */
        td_copy_paste_pc: td_copy_paste_pc {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_COPY_PASTE_PC";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LC(C)>, <&kp LC(V)>;
        };

        // Layer tap dance behaviors

        ZMK_TD_LAYER(td_LAYER_Keypad, 4)

    };
};

