/* Per-key RGB Layer Color Helpers */
#define ___ &ug 0x000000
#define GRN &ug 0x00FF00  /* Numbers & Layer Toggles */
#define MAG &ug 0xFF00FF  /* Vim Arrows (HJKL) */
#define GLD &ug 0xFFBF00  /* Brackets, Quotes & RGB Controls */
#define ORG &ug 0xFF5500  /* Symbols, Math Operators & Gaming Mods */
#define CYN &ug 0x00FFFF  /* Function Keys (F1-F12) & Media Controls */
#define RED &ug 0xFF0000  /* System / Lock / Exit / WASD */
#define BLU &ug 0x0066FF  /* PC & Bluetooth / Connectivity */
#define NML &ug_nl 0x00FF00 0xFF0000  /* NumLock indicator (Green=ON, Red=OFF) */
#define CPL &ug_cl 0x000000 0xFF0000  /* CapsLock indicator (Off=0x000000, On=Red) */

