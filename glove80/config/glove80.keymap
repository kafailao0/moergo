&none        &none            &out OUT_USB     &none            &none                             &tog LAYER_Gaming  &tog LAYER_PC  &none    &none  &none  &none         &kp INS       &kp SLCK      &kp PSCRN     &none  &none
            >;
        };

        layer_Factory {
            bindings = <
&kp NUMBER_0  &kp NUMBER_6  &kp NUMBER_2  &kp NUMBER_8  &kp NUMBER_4                                                                                                                    &kp NUMBER_4  &kp NUMBER_8  &kp NUMBER_2  &kp NUMBER_6  &kp NUMBER_0
&kp NUMBER_1  &kp NUMBER_7  &kp NUMBER_3  &kp NUMBER_9  &kp NUMBER_5  &kp NUMBER_0                                                                                        &kp NUMBER_0  &kp NUMBER_5  &kp NUMBER_9  &kp NUMBER_3  &kp NUMBER_7  &kp NUMBER_1
&kp NUMBER_2  &kp NUMBER_8  &kp NUMBER_4  &kp NUMBER_0  &kp NUMBER_6  &kp NUMBER_1                                                                                        &kp NUMBER_1  &kp NUMBER_6  &kp NUMBER_0  &kp NUMBER_4  &kp NUMBER_8  &kp NUMBER_2
&kp NUMBER_3  &kp NUMBER_9  &kp NUMBER_5  &kp NUMBER_1  &kp NUMBER_7  &kp NUMBER_2                                                                                        &kp NUMBER_2  &kp NUMBER_7  &kp NUMBER_1  &kp NUMBER_5  &kp NUMBER_9  &kp NUMBER_3
&kp NUMBER_4  &kp NUMBER_0  &kp NUMBER_6  &kp NUMBER_2  &kp NUMBER_8  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6    &kp NUMBER_6  &kp NUMBER_5  &kp NUMBER_4  &kp NUMBER_3  &kp NUMBER_8  &kp NUMBER_2  &kp NUMBER_6  &kp NUMBER_0  &kp NUMBER_4
&kp NUMBER_5  &kp NUMBER_1  &kp NUMBER_7  &kp NUMBER_3  &kp NUMBER_9                &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9    &kp NUMBER_9  &kp NUMBER_8  &kp NUMBER_7                &kp NUMBER_9  &kp NUMBER_3  &kp NUMBER_7  &kp NUMBER_1  &kp NUMBER_5
            >;
        };

        layer_Mouse {
            bindings = <
&trans            &trans              &trans      &trans      &trans                                                                                                    &trans          &trans          &trans        &trans           &trans
&trans            &trans              &trans      &trans      &trans      &trans                                                                                &trans  &trans          &trans          &trans        &trans           &trans
&trans            &trans              &mkp MB4    &mkp MB5    &trans      &trans                                                                                &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans  &trans
&trans            &mo LAYER_Sniper    &mkp MCLK   &mkp RCLK   &mkp LCLK   &trans                                                                                &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
&trans            &trans              &trans      &trans      &trans      &trans  &trans  &trans  &trans    &trans    &kp ESC    &trans  &trans          &trans          &trans        &trans           &trans  &trans
&tog LAYER_Mouse  &trans              &trans      &trans      &trans              &trans  &trans  &trans    &mkp MCLK &mkp RCLK  &mkp LCLK               &trans          &trans        &trans           &trans  &trans
            >;
        };

        layer_Sniper {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                                                                                                                &trans                 &trans                 &trans               &trans                  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                                                                &trans                  &trans                 &trans                 &trans               &trans                  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                                                                &msc SNIPER_SCRL_LEFT   &msc SNIPER_SCRL_DOWN  &msc SNIPER_SCRL_UP  &msc SNIPER_SCRL_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                                                                &mmv SNIPER_MOVE_LEFT   &mmv SNIPER_MOVE_DOWN  &mmv SNIPER_MOVE_UP   &mmv SNIPER_MOVE_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans                 &trans                 &trans                &trans                  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans    &trans  &trans  &trans                         &trans                 &trans                &trans                  &trans  &trans
            >;
        };
    };
};

/* Per-key RGB Layer Color Helpers */
#define ___ &ug 0x000000
#define GRN &ug 0x00FF00  /* Numbers & Layer Toggles */
#define MAG &ug 0xFF00FF  /* Vim Arrows (HJKL) & Mouse Movement */
#define GLD &ug 0xFFBF00  /* Brackets, Quotes, Scroll & RGB Controls */
#define ORG &ug 0xFF5500  /* Symbols, Math Operators, Clicks & Gaming Mods */
#define CYN &ug 0x00FFFF  /* Function Keys (F1-F12) & Media Controls */
#define RED &ug 0xFF0000  /* System / Lock / Exit / WASD */
#define BLU &ug 0x0066FF  /* PC & Bluetooth / Connectivity */
#define NML &ug_nl 0x00FF00 0xFF0000  /* NumLock indicator (Green=ON, Red=OFF) */
#define CPL &ug_cl 0x000000 0xFF0000  /* CapsLock indicator (Off=0x000000, On=Red) */

/ {
    underglow-layer {
        compatible = "zmk,underglow-layer";

        /* Base layer: Caps Lock status light on td_caps */
        layer_Base {
            layer-id = <LAYER_Base>;
            bindings = <
 ___  ___  ___  ___  ___                                                                                      ___  ___  ___  ___  ___
 ___  ___  ___  ___  ___  ___                                                                            ___  ___  ___  ___  ___  ___
 CPL  ___  ___  ___  ___  ___                                                                            ___  ___  ___  ___  ___  ___
 ___  ___  ___  ___  ___  ___                                                                            ___  ___  ___  ___  ___  ___
 ___  ___  ___  ___  ___  ___  ___  ___  ___      ___  ___  ___      ___  ___  ___  ___  ___  ___
 ___  ___  ___  ___  ___       ___  ___  ___      ___  ___  ___           ___  ___  ___  ___  ___
            >;
        };

        /* Permanent layer: lights up for 3s when toggled on, then fades out */
        layer_PC {
            layer-id = <LAYER_PC>;
            fade-delay = <3>;
            bindings = <
 ___  ___  ___  ___  ___                                                                                      ___  ___  ___  ___  ___
 ___  ___  ___  ___  ___  ___                                                                            ___  ___  ___  ___  ___  ___
 ___  ___  ___  ___  ___  ___                                                                            ___  ___  ___  ___  ___  ___
 ___  ___  ___  ___  ___  ___                                                                            ___  ___  ___  ___  ___  ___
 ___  ___  ___  ___  ___  ___  ___  ___  ___      ___  ___  ___      ___  ___  ___  ___  ___  ___
 ___  ___  BLU  ___  ___       ___  ___  ___      ___  ___  ___           ___  ___  ___  ___  ___
            >;
        };

        /* Permanent layer: lights up for 3s when toggled on, then fades out */
        layer_Gaming {
            layer-id = <LAYER_Gaming>;
            fade-delay = <3>;
            bindings = <
 ___  ___  ___  ___  ___                                                                                      ___  ___  ___  ___  ___
 ___  ___  ___  ___  ___  ___                                                                            ___  ___  ___  ___  ___  ___
 ORG  ___  ___  ___  ___  ___                                                                            ___  ___  ___  ___  ___  ___
 ___  RED  RED  RED  ORG  ___                                                                            ___  ORG  ORG  ORG  ORG  ___
 ORG  ___  ___  ___  ___  ___  ___  ___  ___      ___  ___  ___      ___  ___  ___  ___  ___  ___
 ___  ___  ORG  ORG  GRN       ___  ORG  ORG      ___  ___  ___           ___  ___  ___  ___  ___
            >;
        };

        /* Momentary layer: stays lit while held */
        layer_SymbolNav {
            layer-id = <LAYER_SymbolNav>;
            bindings = <
 ___  ___  ___  ___  ___                                                                                      ___  ___  ___  ___  ___
 ___  CYN  CYN  CYN  CYN  CYN                                                                            CYN  CYN  CYN  CYN  CYN  CYN
 ___  ORG  GLD  GLD  ORG  ___                                                                            ORG  ORG  ORG  ORG  ORG  CYN
 MAG  ORG  GLD  GLD  GLD  ORG                                                                            MAG  MAG  MAG  MAG  ORG  MAG
 MAG  ORG  GLD  GLD  ORG  ___  ___  ___  ___      ___  ___  ___      ORG  ORG  ORG  ORG  ORG  MAG
 ___  ___  ___  ___  ___       ___  ___  ___      ___  ___  ___           ___  ___  ___  ___  ___
            >;
        };

        /* Hybrid layer: stays lit while active (both held and double-tap toggled) */
        layer_Keypad {
            layer-id = <LAYER_Keypad>;
            bindings = <
 ___  ___  ___  ___  ___                                                                                      ___  ___  ___  ___  ___
 RED  ___  ___  ___  ___  ___                                                                            ___  ___  ___  ___  ___  ___
 ___  ___  ___  ___  ___  ___                                                                            ___  GRN  GRN  GRN  ORG  ORG
 ___  ___  ___  ___  ___  ___                                                                            ___  GRN  GRN  GRN  ORG  ORG
 ___  ___  ___  ___  ___  ___  ___  ___  ___      ___  ___  ___      ORG  GRN  GRN  GRN  ___  ___
 ___  ___  ___  ___  ___       ___  ___  ___      ___  ___  ORG           GRN  ORG  ___  ___  ___
            >;
        };

        /* Momentary layer: stays lit while held */
        layer_NumRow {
            layer-id = <LAYER_NumRow>;
            bindings = <
 ___  ___  ___  ___  ___                                                                                      ___  ___  ___  ___  ___
 ___  ___  ___  ___  ___  ___                                                                            ___  ___  ___  ___  ___  ___
 CPL  ___  ___  ___  ___  ___                                                                            ___  ___  ___  ___  ___  ___
 ___  GRN  GRN  GRN  GRN  GRN                                                                            GRN  GRN  GRN  GRN  GRN  ___
 ___  ___  ___  ___  ___  ___  ___  ___  ___      ___  ___  ___      ___  ___  ___  ___  ___  ___
 ___  ___  ___  ___  ___       ___  ___  ___      ___  ___  ___           ___  ___  ___  ___  ___
            >;
        };

        /* Momentary layer: stays lit while held */
        layer_Magic {
            layer-id = <LAYER_Magic>;
            bindings = <
 ___  ___  ___  ___  ___                                                                                      ___  ___  ___  ___  ___
 RED  ___  ___  ___  ___  ___                                                                            ___  ___  ___  ___  ___  RED
 RED  GLD  GLD  GLD  GLD  GLD                                                                            ___  CYN  CYN  CYN  ___  RED
 RED  GLD  GLD  GLD  GLD  GLD                                                                            ___  CYN  CYN  CYN  ___  RED
 ___  ___  BLU  BLU  BLU  BLU  ___  ___  ___      ___  ___  ___      ___  CYN  CYN  ___  ___  RED
 ___  ___  BLU  ___  ___       GRN  GRN  ___      ___  ___  ___           RED  RED  RED  ___  ___
            >;
        };

        /* Toggled layer: stays lit while active */
        layer_Mouse {
            layer-id = <LAYER_Mouse>;
            bindings = <
 ___  ___  ___  ___  ___                                                                                      ___  ___  ___  ___  ___
 ___  ___  ___  ___  ___  ___                                                                            ___  ___  ___  ___  ___  ___
 ___  ___  ORG  ORG  ___  ___                                                                            GLD  GLD  GLD  GLD  ___  ___
 ___  GRN  ORG  ORG  ORG  ___                                                                            MAG  MAG  MAG  MAG  ___  ___
 ___  ___  ___  ___  ___  ___  ___  ___  ___      ___  RED  ___      ___  ___  ___  ___  ___  ___
 RED  ___  ___  ___  ___       ___  ___  ___      ORG  ORG  ORG           ___  ___  ___  ___  ___
            >;
        };

        /* Momentary layer: stays lit while held */
        layer_Sniper {
            layer-id = <LAYER_Sniper>;
            bindings = <
 ___  ___  ___  ___  ___                                                                                      ___  ___  ___  ___  ___
 ___  ___  ___  ___  ___  ___                                                                            ___  ___  ___  ___  ___  ___
 ___  ___  ___  ___  ___  ___                                                                            GLD  GLD  GLD  GLD  ___  ___
 ___  ___  ___  ___  ___  ___                                                                            RED  RED  RED  RED  ___  ___
 ___  ___  ___  ___  ___  ___  ___  ___  ___      ___  ___  ___      ___  ___  ___  ___  ___  ___
 ___  ___  ___  ___  ___       ___  ___  ___      ___  ___  ___           ___  ___  ___  ___  ___
            >;
        };
    };
};
