            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LC(C)>, <&kp LC(V)>;
        };

        /* @viewer: ⏯ | ⏮ ⏭ | @badge: TD | @tooltip: Tap Dance: 1x Play/Pause • 2x Next Track • 3x Prev Track */
