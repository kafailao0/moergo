 }
+
+#if IS_ENABLED(UNDERGLOW_LAYER_ENABLED)
+static void zmk_rgb_underglow_effect_layer_breathe(void) {
+    if (!layer_breathe_active) {
+        return;
+    }
+
+    uint32_t scale = abs((int)state.animation_step - 1200);
+    for (int i = 0; i < STRIP_NUM_PIXELS; i++) {
+        pixels[i].r = (layer_pixels[i].r * scale + 600) / 1200;
+        pixels[i].g = (layer_pixels[i].g * scale + 600) / 1200;
+        pixels[i].b = (layer_pixels[i].b * scale + 600) / 1200;
+    }
+
+    state.animation_step += state.animation_speed * 10;
+    if (state.animation_step > 2400) {
+        state.animation_step = 0;
+    }
+}
+#endif
 
 static int zmk_led_generate_status(void);
 
