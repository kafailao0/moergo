+#if IS_ENABLED(UNDERGLOW_LAYER_ENABLED)
+static inline bool zmk_rgb_underglow_is_layer_effect(uint8_t effect) {
+    return effect == UNDERGLOW_EFFECT_LAYER_INDICATORS ||
+           effect == UNDERGLOW_EFFECT_LAYER_INDICATORS_PERMANENT ||
+           effect == UNDERGLOW_EFFECT_LAYER_INDICATORS_BREATHE;
